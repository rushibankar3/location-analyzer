# Copy this file to .env and fill in your keys

# ── Apify (review scraper) ────────────────────────────────────────────────────
APIFY_API_TOKEN=your_apify_token_here

# ── Model A — Groq (primary analyst) ─────────────────────────────────────────
# Free tier: https://console.groq.com
# llama-3.3-70b-versatile : 100K TPD, 14,400 TPM — deep sentiment analysis
# llama-3.1-8b-instant    : 500K TPD,  6,000 TPM — guardrail + explanation
GROQ_API_KEY=your_groq_api_key_here
STRONG_MODEL=llama-3.3-70b-versatile
FAST_MODEL=llama-3.1-8b-instant

# ── Model B — Groq llama-3.1-8b-instant (independent verifier) ─────────────
# Uses llama-3.1-8b-instant for verification (most reliable JSON on Groq)
# Large quota: 500K TPD, 6,000 TPM (shared with guardrail, plenty for both)
# Independence through: different stage, different context, cross-validation role
VERIFIER_MODEL=llama-3.1-8b-instant

# Set to true to block results if verification is unavailable
REQUIRE_VERIFICATION=false
